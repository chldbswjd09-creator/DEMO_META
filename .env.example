# ─────────────────────────────────────────────────────────────
# 공용 저장소 (로그인 없음, 모든 방문자 공유) — Supabase(DB 전용, 인증 미사용)
#
# 배포(Netlify)에서 아래 두 값을 환경변수로 넣으면 어느 기기/브라우저에서든
# 같은 데이터가 보입니다. 서버(API 라우트)에서만 사용되며 클라이언트에 노출되지 않습니다.
#
#   SUPABASE_URL=https://xxxx.supabase.co
#   SUPABASE_KEY=<anon public key 권장 (아래 SQL 정책과 함께)>
#     · 또는 SUPABASE_SERVICE_ROLE_KEY 를 넣어도 됩니다(프로젝트 전체 권한이라 anon 권장).
#     · 구 프로젝트의 NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY 도 자동 인식합니다.
#
# Supabase SQL 편집기에서 아래를 1회 실행 (테이블 + 공개 정책):
#   create table if not exists public.store (
#     kind text not null,
#     id   text not null,
#     data jsonb not null,
#     primary key (kind, id)
#   );
#   alter table public.store enable row level security;
#   create policy "public store access" on public.store
#     for all to anon using (true) with check (true);
#
# 위 값이 없으면(로컬 개발 등) 프로젝트 폴더의 .data/store.json 파일에 저장됩니다.
# (파일 저장은 로컬 전용 — 서버리스 호스팅에서는 유지되지 않으니 배포 시 Supabase 필수)
# ─────────────────────────────────────────────────────────────
#
# 공용 비밀번호 로그인 (서버 전용 — 절대 NEXT_PUBLIC 접두사 사용 금지)
#   APP_SHARED_PASSWORD = 모든 기기가 공유하는 하나의 접속 비밀번호
#   AUTH_SECRET         = 세션 서명(HMAC)용 시크릿. 길고 무작위한 값 사용 권장.
#                         예) openssl rand -hex 32  로 생성한 64자 hex
#
# 두 값은 Netlify의 서버 환경변수(Site settings → Environment variables)에만 넣습니다.
# 값이 비어 있으면 아무도 로그인할 수 없습니다(안전 기본값).
# APP_SHARED_PASSWORD=change-me
# AUTH_SECRET=replace-with-64-char-random-hex
#
# ─────────────────────────────────────────────────────────────
# 세션 정책: '마지막 실제 활동 후 3시간' 유휴 만료(절대 만료 없음).
#   실제 활동(클릭/키/스크롤/터치)이 있을 때만 세션이 슬라이딩 갱신됩니다.
#   탭을 닫으면 다음 접속(새 탭)에서 재로그인이 필요합니다(sessionStorage 기반).
#
# 아래 두 값은 '비밀정보가 아니라 시간(테스트용)'입니다. 평소엔 설정하지 않아도 됩니다.
# 3시간을 기다리지 않고 유휴 만료를 테스트하려면 짧게 설정하세요(예: 20초).
#   AUTH_IDLE_SECONDS=20        # 서버 쿠키 만료(초). 미설정 시 10800(3시간).
#   NEXT_PUBLIC_IDLE_MS=20000   # 클라이언트 유휴 판정(ms). 미설정 시 10800000(3시간).
#   · NEXT_PUBLIC_IDLE_MS 는 '시간 값'이라 클라이언트 노출이 허용됩니다(비밀번호/시크릿 아님).
# ─────────────────────────────────────────────────────────────
